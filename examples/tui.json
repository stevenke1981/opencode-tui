{
  "$schema": "https://opencode.ai/tui.json",
  "plugin": [
    [
      "file:D:/qwen_tts/opencode-tui",
      {
        "scope": "session",
        "refreshIntervalMs": 5000,
        "progressRefreshIntervalMs": 30000,
        "activeWindowMs": 120000,
        "showCache": true,
        "showCost": true,
        "showReasoning": false,
        "toggleKey": "ctrl+shift+s",
        "progressWeights": {
          "tasks": 0.5,
          "markers": 0.1,
          "git": 0.2,
          "files": 0.2
        }
      }
    ]
  ]
}
